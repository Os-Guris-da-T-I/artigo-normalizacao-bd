<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 320" width="100%" height="100%">
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;800&amp;display=swap');
      
      .fundo { fill: #111d23; rx: 16px; }
      
      /* Caixas principais de cada Forma Normal */
      .card-1fn { fill: #16242c; stroke: #5bb5b0; stroke-width: 2.5; rx: 16px; }
      .card-2fn { fill: #16242c; stroke: #e59b5d; stroke-width: 2.5; rx: 16px; }
      .card-3fn { fill: #16242c; stroke: #d1a0c8; stroke-width: 2.5; rx: 16px; }
      
      /* Badges do topo de cada card */
      .badge-1fn { fill: #5bb5b0; }
      .badge-2fn { fill: #e59b5d; }
      .badge-3fn { fill: #d1a0c8; }
      
      .badge-texto { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 15px; fill: #111d23; text-anchor: middle; }
      
      /* Textos */
      .titulo { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; font-size: 18px; fill: #ffffff; text-anchor: middle; }
      .subtitulo { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 13.5px; fill: #b5c6cd; text-anchor: middle; }
      .detalhe { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 600; font-size: 12px; fill: #edf4f7; text-anchor: middle; }
      
      /* Seta de conexão */
      .seta { fill: none; stroke: #3c5663; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
      .seta-cabeca { fill: #3c5663; }
    </style>
    
    <!-- Definição da ponta da seta -->
    <marker id="seta-pontal" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 1 L 10 5 L 0 9 z" class="seta-cabeca" />
    </marker>
  </defs>

  <!-- Fundo acompanhando o estilo escuro do artigo -->
  <rect class="fundo" width="900" height="320" />

  <!-- ==================== 1FN ==================== -->
  <g transform="translate(30, 35)">
    <rect class="card-1fn" width="250" height="250" />
    <!-- Badge -->
    <rect class="badge-1fn" x="85" y="20" width="80" height="30" rx="15" />
    <text x="125" y="40" class="badge-texto">1FN</text>
    <!-- Conteúdo -->
    <text x="125" y="90" class="titulo">Valores Atômicos</text>
    <text x="125" y="125" class="subtitulo">Elimina grupos de</text>
    <text x="125" y="145" class="subtitulo">dados repetidos ou listas</text>
    <text x="125" y="165" class="subtitulo">em uma mesma célula.</text>
    
    <rect x="25" y="190" width="200" height="36" rx="8" fill="#1e303a" />
    <text x="125" y="213" class="detalhe">1 valor único por campo</text>
  </g>

  <!-- Seta 1FN -> 2FN -->
  <line x1="295" y1="160" x2="315" y2="160" class="seta" marker-end="url(#seta-pontal)" />

  <!-- ==================== 2FN ==================== -->
  <g transform="translate(325, 35)">
    <rect class="card-2fn" width="250" height="250" />
    <!-- Badge -->
    <rect class="badge-2fn" x="85" y="20" width="80" height="30" rx="15" />
    <text x="125" y="40" class="badge-texto">2FN</text>
    <!-- Conteúdo -->
    <text x="125" y="90" class="titulo">Dependência Total</text>
    <text x="125" y="125" class="subtitulo">Estar na 1FN + eliminar</text>
    <text x="125" y="145" class="subtitulo">dependências parciais</text>
    <text x="125" y="165" class="subtitulo">da chave composta.</text>
    
    <rect x="25" y="190" width="200" height="36" rx="8" fill="#1e303a" />
    <text x="125" y="213" class="detalhe">Depende de TODA a chave</text>
  </g>

  <!-- Seta 2FN -> 3FN -->
  <line x1="590" y1="160" x2="610" y2="160" class="seta" marker-end="url(#seta-pontal)" />

  <!-- ==================== 3FN ==================== -->
  <g transform="translate(620, 35)">
    <rect class="card-3fn" width="250" height="250" />
    <!-- Badge -->
    <rect class="badge-3fn" x="85" y="20" width="80" height="30" rx="15" />
    <text x="125" y="40" class="badge-texto">3FN</text>
    <!-- Conteúdo -->
    <text x="125" y="90" class="titulo">Sem Transitividade</text>
    <text x="125" y="125" class="subtitulo">Estar na 2FN + remover</text>
    <text x="125" y="145" class="subtitulo">atributos que dependem</text>
    <text x="125" y="165" class="subtitulo">de outros não-chaves.</text>
    
    <rect x="25" y="190" width="200" height="36" rx="8" fill="#1e303a" />
    <text x="125" y="213" class="detalhe">Separa dados indiretos</text>
  </g>
</svg>
