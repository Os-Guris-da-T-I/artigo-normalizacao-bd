/*
  Artigo: Do dado repetido ao banco organizado
  SGBD: PostgreSQL 15 ou superior
  ATENÇÃO: execute apenas em um banco de testes vazio.
  Os dados abaixo são fictícios, sem qualquer vínculo com pessoas, clientes ou empresas reais.
*/

BEGIN;

-- Limpeza prévia do ambiente de testes (remove na ordem correta devido às chaves estrangeiras)
DROP TABLE IF EXISTS alternativas;
DROP TABLE IF EXISTS perguntas;
DROP TABLE IF EXISTS fontes;
DROP TABLE IF EXISTS categorias;

-- 1. Tabela de Categorias (Atende à 3FN separando o domínio temático)
CREATE TABLE categorias (
    id_categoria INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome VARCHAR(80) NOT NULL UNIQUE
);

-- 2. Tabela de Fontes (Elimina a redundância e anomalias de atualização/exclusão)
CREATE TABLE fontes (
    id_fonte INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    url VARCHAR(250) NOT NULL UNIQUE
);

-- 3. Tabela Principal de Perguntas (Relacionada via Chaves Estrangeiras)
CREATE TABLE perguntas (
    id_pergunta INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    enunciado TEXT NOT NULL,
    resposta_correta BOOLEAN NOT NULL,
    id_categoria INTEGER NOT NULL REFERENCES categorias(id_categoria),
    id_fonte INTEGER NOT NULL REFERENCES fontes(id_fonte)
);

-- 4. Tabela de Alternativas (Garante a 1FN: valores atômicos sem listas internas na mesma célula)
CREATE TABLE alternativas (
    id_alternativa INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    id_pergunta INTEGER NOT NULL REFERENCES perguntas(id_pergunta) ON DELETE CASCADE,
    texto VARCHAR(80) NOT NULL,
    valor_logico BOOLEAN NOT NULL,
    CONSTRAINT uq_alternativa_por_pergunta UNIQUE (id_pergunta, texto)
);

