-- =========================================================================
-- CONSULTAS DE DEMONSTRAÇÃO (Para rodar no Query Tool do pgAdmin)
-- =========================================================================

-- Consulta 1: Mostrar perguntas integradas com categoria e fonte (Demonstra o JOIN)
SELECT p.id_pergunta, p.enunciado, c.nome AS categoria,
       f.nome AS fonte, f.url
FROM perguntas p
JOIN categorias c ON c.id_categoria = p.id_categoria
JOIN fontes f ON f.id_fonte = p.id_fonte
ORDER BY p.id_pergunta;

-- Consulta 2: Mostrar as alternativas atômicas de cada pergunta (Demonstra a 1FN)
SELECT p.enunciado, a.texto AS alternativa, a.valor_logico
FROM perguntas p
JOIN alternativas a ON a.id_pergunta = p.id_pergunta
ORDER BY p.id_pergunta, a.id_alternativa;

-- Consulta 3: Contar quantas perguntas existem por categoria (Agrupamento útil)
SELECT c.nome AS categoria, COUNT(p.id_pergunta) AS total_perguntas
FROM categorias c
LEFT JOIN perguntas p ON p.id_categoria = c.id_categoria
GROUP BY c.id_categoria, c.nome
ORDER BY c.nome;

